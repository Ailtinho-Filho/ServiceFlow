generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  ATTENDANT
}

enum ServiceStatus {
  RECEIVED
  DIAGNOSIS
  QUOTE
  APPROVED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELED
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum PaymentType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(ATTENDANT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  services     Service[]     @relation("TechnicianServices")
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  email      String?
  phone      String
  document   String?
  address    String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  equipment  Equipment[]
  services   Service[]
}

model Equipment {
  id           String      @id @default(cuid())
  customerId   String
  name         String
  brand        String?
  model        String?
  serialNumber String?
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  services     Service[]

  @@index([customerId])
  @@index([serialNumber])
}

model Service {
  id           String        @id @default(cuid())
  code         Int           @unique @default(autoincrement())
  customerId   String
  equipmentId  String?
  technicianId String?
  title        String
  description  String?
  status       ServiceStatus @default(RECEIVED)
  laborCost    Decimal       @default(0) @db.Decimal(12, 2)
  partsCost    Decimal       @default(0) @db.Decimal(12, 2)
  totalCost    Decimal       @default(0) @db.Decimal(12, 2)
  receivedAt   DateTime      @default(now())
  dueDate      DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  technician   User?         @relation("TechnicianServices", fields: [technicianId], references: [id], onDelete: SetNull)
  quote        Quote?

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  serviceId   String      @unique
  status      QuoteStatus @default(PENDING)
  partsCost   Decimal     @db.Decimal(12, 2)
  laborCost   Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  notes       String?
  validUntil  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String        @id @default(cuid())
  description String
  type        PaymentType
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  category    String?
  reference   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status])
  @@index([dueDate])
}
